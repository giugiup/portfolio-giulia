---
import Layout from '../../layouts/Layout.astro';
import ProjectTemplate from '../../components/ProjectTemplate.astro';
import { projectPages } from '../../data/projects.js';

export function getStaticPaths() {
  return projectPages.map(project => ({ params: { slug: project.slug }, props: { project } }));
}

const { project } = Astro.props;
const pageTitle = project.page.pageTitle ?? `${project.title} — Giulia Moraes`;
const metaDescription = project.page.metaDescription ?? project.description;
const ogImage = project.page.ogImage;
---
<Layout title={pageTitle} description={metaDescription} ogImage={ogImage}>
  <ProjectTemplate project={project} />
</Layout>
