---
const linkedinHref = '';
const behanceHref = '';
---

<footer class="site-footer" aria-label="Rodapé do site">
  <p class="site-footer__copyright">Giulia Moraes — 2026</p>

  <div class="site-footer__social" aria-label="Redes sociais">
    {linkedinHref ? (
      <a class="site-footer__link" href={linkedinHref} target="_blank" rel="noreferrer">LinkedIn</a>
    ) : (
      <span class="site-footer__link site-footer__link--text">LinkedIn</span>
    )}

    <span class="site-footer__separator" aria-hidden="true">·</span>

    {behanceHref ? (
      <a class="site-footer__link" href={behanceHref} target="_blank" rel="noreferrer">Behance</a>
    ) : (
      <span class="site-footer__link site-footer__link--text">Behance</span>
    )}
  </div>
</footer>

<style>
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 96px;
    padding-inline: 80px;
    border-top: 1px solid var(--color-border-strong);
    background: var(--color-bg-page);
    color: var(--color-text-primary);
    box-sizing: border-box;
  }

  .site-footer__copyright {
    margin: 0;
    font-family: var(--font-family-base);
    font-size: 13px;
    font-weight: var(--font-weight-regular);
    line-height: normal;
    color: var(--color-text-primary);
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }

  .site-footer__link,
  .site-footer__link--text {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-family-base);
    font-size: 13px;
    font-weight: var(--font-weight-regular);
    line-height: normal;
    color: var(--color-text-primary);
    text-decoration: none;
    transition: opacity var(--motion-duration-micro) var(--motion-ease-out), text-decoration-color var(--motion-duration-micro) var(--motion-ease-out);
  }

  .site-footer__link:hover,
  .site-footer__link:focus-visible {
    opacity: 0.8;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .site-footer__link:focus-visible {
    outline: 2px solid var(--color-text-primary);
    outline-offset: 4px;
    border-radius: 2px;
  }

  .site-footer__separator {
    color: var(--color-text-primary);
  }

  @media (max-width: 1279px) {
    .site-footer {
      padding-inline: var(--layout-gutter-tablet);
    }
  }

  @media (max-width: 767px) {
    .site-footer {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      justify-content: center;
      gap: 12px;
      min-height: 96px;
      padding-inline: var(--layout-gutter-mobile);
      padding-block: 20px;
    }

    .site-footer__social {
      gap: 8px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-footer__link,
    .site-footer__link--text {
      transition: none;
    }
  }
</style>
