---
import '../styles/contact-footer.css';

const linkedinHref = 'https://www.linkedin.com/in/giugium/?isSelfProfile=true';
const behanceHref = 'https://www.behance.net/giup';
---

<footer class="site-footer" aria-label="Rodapé do site">
  <p class="site-footer__copyright">Giulia Moraes — 2026</p>
  <div class="site-footer__social" aria-label="Redes sociais">
    {linkedinHref ? (
      <a class="site-footer__link" href={linkedinHref} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    ) : <span>LinkedIn</span>}
    <span class="site-footer__separator" aria-hidden="true">·</span>
    {behanceHref ? (
      <a class="site-footer__link" href={behanceHref} target="_blank" rel="noopener noreferrer">Behance</a>
    ) : <span>Behance</span>}
  </div>
</footer>
