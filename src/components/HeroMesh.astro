<div class="hero__mesh" aria-hidden="true">
	<canvas class="hero__mesh-canvas"></canvas>
</div>

<script>
	(() => {
		const hero = document.querySelector('.hero');
		const mesh = hero?.querySelector('.hero__mesh');
		const canvas = mesh?.querySelector('canvas');
		if (!hero || !mesh || !canvas) return;

		mesh.style.position = 'absolute';
		mesh.style.inset = '0';
		mesh.style.zIndex = '0';
		mesh.style.pointerEvents = 'none';
		canvas.style.pointerEvents = 'none';

		const content = hero.querySelector('.hero__content');
		const brands = hero.querySelector('.hero__brands');
		if (content) content.style.zIndex = '2';
		if (brands) brands.style.zIndex = '2';

		const context = canvas.getContext('2d');
		if (!context) return;

		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		const touchMode = window.matchMedia('(pointer: coarse)').matches;
		const LINK_DIST = 142;
		const MOUSE_DIST = 210;
		const state = {
			width: 0,
			height: 0,
			dpr: 1,
			nodes: [],
			pointer: { x: 0, y: 0 },
			easedPointer: { x: 0, y: 0 },
			isActive: false,
			raf: 0,
		};

		const clamp = (value, min, max) => Math.min(Math.max(value, min), max);

		const createNodes = () => {
			const width = hero.clientWidth || 0;
			const height = hero.clientHeight || 0;
			if (!width || !height) return;

			const area = width * height;
			const target = Math.min(
				130,
				Math.max(
					70,
					Math.round(area / 11000)
				)
			);
			const nodeCount = touchMode ? Math.min(62, target) : target;
			const nodes = [];
			const safeZoneLeft = width * 0.22;
			const safeZoneRight = width * 0.78;
			const safeZoneTop = height * 0.14;
			const safeZoneBottom = height * 0.72;

			while (nodes.length < nodeCount) {
				const x = Math.random() * width;
				const y = Math.random() * height;
				const inSafeZone = x > safeZoneLeft && x < safeZoneRight && y > safeZoneTop && y < safeZoneBottom;
				if (inSafeZone && Math.random() < 0.42) {
					continue;
				}

				nodes.push({
					ox: x,
					oy: y,
					x,
					y,
					ax: 14 + Math.random() * 26,
					ay: 14 + Math.random() * 26,
					fx: 0.12 + Math.random() * 0.22,
					fy: 0.12 + Math.random() * 0.22,
					phaseX: Math.random() * Math.PI * 2,
					phaseY: Math.random() * Math.PI * 2,
					radius: 0.8 + Math.random() * 1.4,
				});
			}

			state.nodes = nodes;
		};

		const resizeCanvas = () => {
			const rect = hero.getBoundingClientRect();
			state.width = rect.width;
			state.height = rect.height;
			state.dpr = Math.min(window.devicePixelRatio || 1, 1.5);
			canvas.width = Math.round(state.width * state.dpr);
			canvas.height = Math.round(state.height * state.dpr);
			canvas.style.width = `${state.width}px`;
			canvas.style.height = `${state.height}px`;
			context.setTransform(state.dpr, 0, 0, state.dpr, 0, 0);
			createNodes();
		};

		const draw = () => {
			const width = state.width;
			const height = state.height;
			if (!width || !height) return;

			context.clearRect(0, 0, width, height);
			const time = performance.now() * 0.001;

			if (state.isActive) {
				state.easedPointer.x += (state.pointer.x - state.easedPointer.x) * 0.12;
				state.easedPointer.y += (state.pointer.y - state.easedPointer.y) * 0.12;
			} else {
				state.easedPointer.x += ((width * 0.5) - state.easedPointer.x) * 0.08;
				state.easedPointer.y += ((height * 0.5) - state.easedPointer.y) * 0.08;
			}

			const nodes = state.nodes;
			for (let index = 0; index < nodes.length; index += 1) {
				const node = nodes[index];
				const driftX = Math.sin(time * node.fx + node.phaseX) * node.ax;
				const driftY = Math.cos(time * node.fy + node.phaseY) * node.ay;
				let nextX = node.ox + driftX;
				let nextY = node.oy + driftY;

				if (state.isActive) {
					const dx = nextX - state.easedPointer.x;
					const dy = nextY - state.easedPointer.y;
					const distance = Math.hypot(dx, dy) || 1;
					if (distance < MOUSE_DIST) {
						const pull = (1 - distance / MOUSE_DIST) * 24;
						nextX += (dx / distance) * pull;
						nextY += (dy / distance) * pull;
					}
				}

				node.x = nextX;
				node.y = nextY;
			}

			for (let index = 0; index < nodes.length; index += 1) {
				for (let nextIndex = index + 1; nextIndex < nodes.length; nextIndex += 1) {
					const a = nodes[index];
					const b = nodes[nextIndex];
					const dx = a.x - b.x;
					const dy = a.y - b.y;
					const distance = Math.hypot(dx, dy) || 1;

					if (distance < LINK_DIST) {
						const alpha = (1 - distance / LINK_DIST) * 0.22;
						context.beginPath();
						context.moveTo(a.x, a.y);
						context.lineTo(b.x, b.y);
						context.strokeStyle = `rgba(217, 185, 167, ${alpha})`;
						context.lineWidth = 0.9;
						context.stroke();
					}
				}
			}

			if (state.isActive) {
				context.save();
				context.setLineDash([6, 6]);
				context.lineDashOffset = -time * 22;
				for (let index = 0; index < nodes.length; index += 1) {
					const node = nodes[index];
					const dx = node.x - state.easedPointer.x;
					const dy = node.y - state.easedPointer.y;
					const distance = Math.hypot(dx, dy) || 1;
					if (distance < MOUSE_DIST) {
						context.beginPath();
						context.moveTo(state.easedPointer.x, state.easedPointer.y);
						context.lineTo(node.x, node.y);
						context.strokeStyle = `rgba(242, 228, 220, ${(1 - distance / MOUSE_DIST) * 0.2})`;
						context.stroke();
					}
				}
				context.restore();
			}

			for (let index = 0; index < nodes.length; index += 1) {
				const node = nodes[index];
				let radius = node.radius;
				if (state.isActive) {
					const dx = node.x - state.easedPointer.x;
					const dy = node.y - state.easedPointer.y;
					const distance = Math.hypot(dx, dy) || 1;
					if (distance < MOUSE_DIST) {
						radius += (1 - distance / MOUSE_DIST) * 1.8;
					}
				}

				context.beginPath();
				context.fillStyle = `rgba(217, 185, 167, 0.9)`;
				context.arc(node.x, node.y, radius, 0, Math.PI * 2);
				context.fill();
			}
		};

		const animate = () => {
			if (reducedMotion) {
				draw();
				return;
			}
			draw();
			state.raf = requestAnimationFrame(animate);
		};

		const handlePointerMove = (event) => {
			const rect = hero.getBoundingClientRect();
			state.pointer.x = event.clientX - rect.left;
			state.pointer.y = event.clientY - rect.top;
			state.isActive = true;
		};

		const handlePointerLeave = () => {
			state.isActive = false;
		};

		hero.addEventListener('pointermove', handlePointerMove, { passive: true });
		hero.addEventListener('pointerleave', handlePointerLeave);

		const observer = new IntersectionObserver(
			(entries) => {
				const entry = entries[0];
				if (!entry) return;
				if (entry.isIntersecting) {
					if (!reducedMotion && !state.raf) {
						state.raf = requestAnimationFrame(animate);
					}
				} else if (state.raf) {
					cancelAnimationFrame(state.raf);
					state.raf = 0;
				}
			},
			{ threshold: 0.1 }
		);

		observer.observe(hero);
		window.addEventListener('resize', resizeCanvas, { passive: true });
		resizeCanvas();
		draw();

		if (!reducedMotion && !state.raf) {
			state.raf = requestAnimationFrame(animate);
		}
	})();
</script>
