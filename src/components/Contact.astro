---
import Button from './Button.astro';
import '../styles/contact-footer.css';

const { href } = Astro.props;
---

<section class="contact" id="contato" aria-labelledby="contact-title">
  <div class="contact__surface">
    <div class="contact__content">
      <h2 class="contact__title" id="contact-title">Vamos conversar sobre o próximo passo?</h2>
      <p class="contact__description">Seja para um novo projeto, uma oportunidade de trabalho ou uma conversa sobre design e produto, estou por aqui.</p>
      <div class="contact__actions">
        <Button text="Entre em contato" href={href} variant="contact" iconSrc="/icons/arrow-northeast.svg" dataCursor="contact" />
        <Button text="Voltar para o topo" variant="contact-top" showIcon={false} dataCursor="" />
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelector<HTMLButtonElement>('.contact .button--contact-top')?.addEventListener('click', () => {
    window.scrollTo({
      top: 0,
      behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth',
    });
  });
</script>
