---
interface Props {
	id: string;
	title: string;
	description: string;
	tags: readonly string[];
	height?: number;
	href?: string;
	image?: { src: string; alt: string; width: number; height: number };
}

const { id, title, description, tags, height = 600, href, image } = Astro.props;
const Card = href ? 'a' : 'div';
---

<article aria-labelledby={`${id}-title`} data-cursor="project">
	<Card class="project-card" href={href} style={`--project-height: ${height}px; --project-ratio: 400 / ${height}`} data-cursor="project">
		{image && <img class="project-card__cover" src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />}
		<div class="project-card__header" aria-hidden="true">
			<span class="project-card__arrow">
				<img class="project-card__arrow-default" src="/icons/project-arrow.svg" alt="" width="32" height="32" />
				<img class="project-card__arrow-hover" src="/icons/project-arrow-hover.svg" alt="" width="32" height="32" />
			</span>
		</div>
		<div class="project-card__content">
			<h3 id={`${id}-title`}>{title}</h3>
			<p>{description}</p>
			<ul class="project-card__tags" aria-label="Categorias">
				{tags.map((tag) => <li>{tag}</li>)}
			</ul>
		</div>
	</Card>
</article>

<style>
	.project-card {
		/* Project Card / Masonry 336:1387: Default + Hover. */
		position: relative;
		isolation: isolate;
		display: flex;
		flex-direction: column;
		justify-content: space-between;
		gap: var(--space-32);
		inline-size: 100%;
		aspect-ratio: var(--project-ratio);
		padding: var(--space-32);
		overflow: hidden;
		border: var(--border-width-1) solid var(--color-border-subtle);
		border-radius: var(--card-radius);
		background-color: var(--color-bg-page);
		color: var(--color-text-primary);
		font-family: var(--font-family-base);
		letter-spacing: 0;
		text-decoration: none;
		transition: background-color var(--motion-duration-base) var(--motion-ease-out),
			border-color var(--motion-duration-base) var(--motion-ease-out);
	}

	.project-card::before {
		/* O fundo do Figma mantém 400 × 600 mesmo nos cards mais baixos. */
		content: '';
		position: absolute;
		z-index: -1;
		inset-block-start: -1px;
		inset-inline-start: -1px;
		inline-size: calc(100% + 2px);
		aspect-ratio: 400 / 600;
		background: linear-gradient(107.10273019971713deg,
			var(--color-accent) 5.2632%, var(--color-wine) 50.877%, var(--color-dark) 92.982%);
		opacity: 0.25;
		pointer-events: none;
	}

	.project-card__cover {
		position: absolute;
		z-index: -1;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		object-fit: cover;
	}

	.project-card__header { display: flex; justify-content: flex-end; }
	.project-card__arrow { position: relative; inline-size: 32px; block-size: 32px; }
	.project-card__arrow img {
		position: absolute;
		inset: 0;
		inline-size: 100%;
		block-size: 100%;
		transition: opacity var(--motion-duration-base) var(--motion-ease-out);
	}
	.project-card__arrow-hover { opacity: 0; }
	.project-card__content { display: flex; flex-direction: column; gap: var(--space-16); min-inline-size: 0; }
	h3, p, ul { margin: 0; }
	h3 {
		font-size: var(--font-size-22);
		font-weight: var(--font-weight-bold);
		line-height: var(--line-height-28);
		overflow-wrap: anywhere;
	}
	p {
		min-block-size: calc(2 * var(--line-height-22));
		color: var(--color-text-secondary);
		font-size: var(--font-size-15);
		font-weight: var(--font-weight-regular);
		line-height: var(--line-height-22);
		overflow-wrap: anywhere;
	}
	.project-card__tags { display: flex; flex-wrap: wrap; gap: var(--space-8); padding: 0; list-style: none; }
	.project-card__tags li {
		max-inline-size: 100%;
		padding: var(--space-4) var(--space-12);
		border: var(--border-width-1) solid var(--color-border-subtle);
		border-radius: var(--radius-8);
		background: var(--color-tag-bg);
		color: var(--color-tag-text);
		font-size: var(--font-size-11);
		font-weight: var(--font-weight-regular);
		line-height: var(--line-height-16);
		overflow-wrap: anywhere;
	}

	/* No Figma, Hover sobrepõe preto à base, mantendo o gradiente a 25%. */
	.project-card:focus-visible { background-color: #000; border-color: var(--color-border-strong); outline: 2px solid var(--color-text-primary); outline-offset: 4px; }
	.project-card:focus-visible .project-card__arrow-default { opacity: 0; }
	.project-card:focus-visible .project-card__arrow-hover { opacity: 1; }
	@media (hover: hover) {
		.project-card:hover { background-color: #000; border-color: var(--color-border-strong); }
		.project-card:hover .project-card__arrow-default { opacity: 0; }
		.project-card:hover .project-card__arrow-hover { opacity: 1; }
	}
	@media (min-width: 1280px) {
		.project-card { min-block-size: var(--project-height); aspect-ratio: auto; }
	}
</style>
