---
import { experiences } from '../data/experience.js';

// SVGs originais do Figma (20 × 20), incorporados para manter esta etapa em dois arquivos.
const icons = {
	plus: 'data:image/svg+xml;base64,',
	previous: 'data:image/svg+xml;base64,',
	next: 'data:image/svg+xml;base64,',
};
---

<section id="experiencia" class="experience page-gutters" aria-labelledby="experience-title">
	<div class="experience__sticky">
		<div class="experience__layout container">
			<div class="experience__intro-column">
				<header class="experience__intro">
					<h2 id="experience-title">Minha trajetória conecta comunicação visual, web e UX/UI</h2>
					<p class="experience__subtitle">evoluindo para interfaces, sistemas e experiências digitais.</p>
				</header>
				<div class="experience__navigation" role="group" aria-label="Navegação entre experiências">
					<button class="experience__navigation-button" type="button" aria-label="Experiência anterior" data-experience-previous data-cursor="control" disabled>
						<img src={icons.previous} alt="" width="20" height="20" />
					</button>
					<button class="experience__navigation-button" type="button" aria-label="Próxima experiência" data-experience-next data-cursor="control">
						<img src={icons.next} alt="" width="20" height="20" />
					</button>
				</div>
			</div>

			<div class="experience__roulette">
				<ol class="experience__track" role="list" aria-label="Experiências profissionais">
					{experiences.map((experience, index) => (
						<li class:list={['experience__entry', {
							'is-active': index === 0,
							'is-near': index === 1,
							'is-far': index > 1,
						}]} data-experience-id={experience.id}>
							<div class="experience__item">
								<button
									class="experience__expand"
									type="button"
									aria-label={`Ver detalhes de ${experience.displayTitle ?? experience.role} — ${experience.company}`}
									aria-controls={`experience-details-${experience.id}`}
									aria-expanded="false"
									data-cursor="view"
								>
									<img src={icons.plus} alt="" width="20" height="20" />
								</button>
								<button class="experience__copy" type="button" aria-pressed={index === 0 ? 'true' : 'false'} data-cursor="view">
									<span class="experience__item-title">{experience.displayTitle ?? experience.role}</span>
									<span class="experience__item-meta">{experience.company} · {experience.period}</span>
								</button>
							</div>
							<div class="experience__details-reveal" id={`experience-details-${experience.id}`} aria-hidden="true" inert>
								<div class="experience__details-inner">
									<div class="experience__details">
										<p class="experience__details-description">{experience.description}</p>
										<ul class="experience__skills" aria-label={`Habilidades — ${experience.company}`}>
											{experience.skills.map((skill) => <li>{skill}</li>)}
										</ul>
									</div>
								</div>
							</div>
						</li>
					))}
				</ol>
			</div>
		</div>
	</div>
</section>

<script>
	const section = document.querySelector<HTMLElement>('#experiencia');
	if (section) {
		const sticky = section.querySelector<HTMLElement>('.experience__sticky')!;
		const viewport = section.querySelector<HTMLElement>('.experience__roulette')!;
		const track = section.querySelector<HTMLElement>('.experience__track')!;
		const entries = [...section.querySelectorAll<HTMLElement>('.experience__entry')];
		const copies = [...section.querySelectorAll<HTMLButtonElement>('.experience__copy')];
		const expandButtons = [...section.querySelectorAll<HTMLButtonElement>('.experience__expand')];
		const details = [...section.querySelectorAll<HTMLElement>('.experience__details-reveal')];
		const previous = section.querySelector<HTMLButtonElement>('[data-experience-previous]')!;
		const next = section.querySelector<HTMLButtonElement>('[data-experience-next]')!;
		let activeIndex = 0;
		let detailModeOpen = false;
		let measureFrame = 0;
		const desktop = window.matchMedia('(min-width: 1280px)');
		const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
		let scrollFrame = 0;
		let geometryFrame = 0;
		let stickyTop = 0;
		let scrollStep = 0;
		let scrollDistance = 0;
		let programmaticTargetIndex: number | null = null;

		function scheduleCenter() {
			if (measureFrame) return;
			measureFrame = requestAnimationFrame(() => {
				measureFrame = 0;
				const entry = entries[activeIndex];
				const entryCenter = entry.offsetTop + entry.offsetHeight / 2;
				track.style.transform = `translateY(${viewport.clientHeight / 2 - entryCenter}px)`;
			});
		}

		function render() {
			entries.forEach((entry, index) => {
				const distance = Math.abs(index - activeIndex);
				const open = distance === 0 && detailModeOpen;
				entry.classList.toggle('is-active', distance === 0);
				entry.classList.toggle('is-near', distance === 1);
				entry.classList.toggle('is-far', distance >= 2);
				entry.classList.toggle('is-open', open);
				copies[index].setAttribute('aria-pressed', String(distance === 0));
				expandButtons[index].setAttribute('aria-expanded', String(open));
				const title = copies[index].textContent?.trim().replace(/\s+/g, ' ');
				expandButtons[index].setAttribute('aria-label', `${open ? 'Fechar' : 'Ver'} detalhes de ${title}`);
				details[index].setAttribute('aria-hidden', String(!open));
				details[index].inert = !open;
			});
			previous.disabled = activeIndex === 0;
			next.disabled = activeIndex === entries.length - 1;
			scheduleCenter();
		}

		function select(index: number, syncScroll = false) {
			const nextIndex = Math.max(0, Math.min(entries.length - 1, index));
			if (nextIndex !== activeIndex) {
				activeIndex = nextIndex;
				render();
			}
			if (syncScroll && desktop.matches) scrollToIndex(nextIndex);
		}

		function targetDocumentScroll(index: number, stageTop: number) {
			const target = window.scrollY + stageTop - stickyTop + index * scrollStep;
			const maxScroll = Math.max(0, document.documentElement.scrollHeight - window.innerHeight);
			return Math.max(0, Math.min(maxScroll, target));
		}

		function scrollToIndex(index: number) {
			programmaticTargetIndex = index;
			window.scrollTo({
				top: targetDocumentScroll(index, section!.getBoundingClientRect().top),
				behavior: reducedMotion.matches ? 'auto' : 'smooth',
			});
			// Também libera o alvo quando o scroll já está na posição solicitada.
			scheduleScroll();
		}

		function scheduleScroll() {
			if (!desktop.matches || scrollFrame || scrollStep <= 0) return;
			scrollFrame = requestAnimationFrame(() => {
				scrollFrame = 0;
				if (!desktop.matches) return;
				const stageTop = section!.getBoundingClientRect().top;
				if (programmaticTargetIndex !== null) {
					const target = targetDocumentScroll(programmaticTargetIndex, stageTop);
					if (Math.abs(window.scrollY - target) > 2) return;
					programmaticTargetIndex = null;
				}
				const offset = Math.max(0, Math.min(scrollDistance, stickyTop - stageTop));
				select(Math.round(offset / scrollStep));
			});
		}

		function interruptProgrammaticScroll() {
			if (programmaticTargetIndex === null) return;
			programmaticTargetIndex = null;
			// Cancela somente nossa navegação suave, sem bloquear o gesto nativo.
			window.scrollTo({ top: window.scrollY, behavior: 'auto' });
			scheduleScroll();
		}

		function scheduleGeometry() {
			if (geometryFrame) return;
			geometryFrame = requestAnimationFrame(() => {
				geometryFrame = 0;
				const styles = getComputedStyle(section!);
				stickyTop = parseFloat(styles.getPropertyValue('--nav-height')) || 0;
				scrollStep = Math.max(1, parseFloat(styles.getPropertyValue('--experience-scroll-step')) || 1);
				scrollDistance = Math.max(0, entries.length - 1) * scrollStep;
				const stickyHeight = sticky.offsetHeight;
				interruptProgrammaticScroll();
				section!.style.setProperty('--experience-sticky-height', `${stickyHeight}px`);
				section!.style.setProperty('--experience-scroll-distance', `${scrollDistance}px`);
				section!.toggleAttribute('data-scroll-driven', desktop.matches);
				scheduleCenter();
				scheduleScroll();
			});
		}

		previous.addEventListener('click', () => select(activeIndex - 1, true));
		next.addEventListener('click', () => select(activeIndex + 1, true));
		copies.forEach((copy, index) => copy.addEventListener('click', () => select(index, true)));
		expandButtons.forEach((button, index) => button.addEventListener('click', () => {
			if (index === activeIndex) {
				detailModeOpen = !detailModeOpen;
				render();
			} else {
				detailModeOpen = true;
				select(index, true);
			}
		}));

		window.addEventListener('scroll', scheduleScroll, { passive: true });
		window.addEventListener('resize', scheduleGeometry);
		window.addEventListener('load', scheduleGeometry, { once: true });
		window.addEventListener('pageshow', scheduleGeometry);
		desktop.addEventListener('change', scheduleGeometry);
		reducedMotion.addEventListener('change', () => {
			if (programmaticTargetIndex !== null) scrollToIndex(programmaticTargetIndex);
		});
		window.addEventListener('wheel', interruptProgrammaticScroll, { passive: true });
		window.addEventListener('touchstart', interruptProgrammaticScroll, { passive: true });
		window.addEventListener('pointerdown', (event) => {
			if (event.target instanceof Element && event.target.closest('#experiencia button')) return;
			interruptProgrammaticScroll();
		}, { passive: true });
		window.addEventListener('keydown', (event) => {
			if (!['ArrowUp', 'ArrowDown', 'PageUp', 'PageDown', 'Home', 'End', ' '].includes(event.key)) return;
			if (event.target instanceof Element) {
				if (event.target.closest('input, textarea, select, [contenteditable]')) return;
				if (event.key === ' ' && event.target.closest('button')) return;
			}
			interruptProgrammaticScroll();
		});
		// Posição real é a verificação principal; scrollend também cobre paradas antecipadas.
		document.addEventListener('scrollend', (event) => {
			if (event.target !== document) return;
			programmaticTargetIndex = null;
			scheduleScroll();
		});

		// A altura natural muda durante o reveal e nas quebras de texto.
		const resizeObserver = new ResizeObserver(scheduleCenter);
		resizeObserver.observe(viewport);
		entries.forEach((entry) => resizeObserver.observe(entry));
		const stickyResizeObserver = new ResizeObserver(scheduleGeometry);
		stickyResizeObserver.observe(sticky);
		document.fonts.ready.then(scheduleGeometry);
		render();
		scheduleGeometry();
	}
</script>

<style>
	.experience {
		--experience-scroll-step: 320px;
		--experience-visual-height: 720px;
		--experience-viewport-height: 560px;
		--experience-active-height: 74px;
		--experience-control-border: rgba(242, 228, 220, 0.18);
		--experience-details-duration: 440ms;
		--experience-details-ease: cubic-bezier(.2, .8, .2, 1);
		background: transparent;
		color: var(--color-text-primary);
		letter-spacing: 0;
	}
	.experience__layout {
		display: grid;
		inline-size: 100%;
		box-sizing: border-box;
		grid-template-columns: 430px minmax(0, 1fr);
		align-items: center;
		gap: var(--space-80);
		min-inline-size: 0;
		min-block-size: var(--experience-visual-height);
		padding-block: var(--space-80);
	}
	.experience__intro-column {
		display: flex;
		inline-size: 100%;
		flex-direction: column;
		gap: var(--space-28);
		min-inline-size: 0;
	}
	.experience__intro {
		display: flex;
		flex-direction: column;
		gap: var(--space-20);
	}
	.experience__intro h2,
	.experience__subtitle,
	.experience__item-title,
	.experience__item-meta {
		margin: 0;
	}
	.experience__intro h2 {
		font-size: var(--font-size-40);
		font-weight: var(--font-weight-extra-bold);
		line-height: var(--line-height-48, 48px);
		overflow-wrap: break-word;
	}
	.experience__subtitle {
		max-inline-size: 410px;
		font-size: var(--font-size-17);
		font-weight: var(--font-weight-regular);
		line-height: var(--line-height-25);
		opacity: 0.72;
	}
	.experience__navigation {
		display: flex;
		gap: var(--space-12);
	}
	.experience__navigation-button,
	.experience__expand {
		display: flex;
		align-items: center;
		justify-content: center;
		flex: none;
		padding: 0;
		border: var(--border-width-1) solid var(--experience-control-border);
		border-radius: var(--radius-full);
		background: transparent;
		color: inherit;
	}
	.experience__navigation-button {
		inline-size: 44px;
		block-size: 44px;
	}
	.experience__navigation-button:disabled { opacity: 0.3; }
	.experience__navigation-button:focus-visible,
	.experience__copy:focus-visible,
	.experience__expand:focus-visible {
		outline: var(--border-width-2) solid var(--color-text-primary);
		outline-offset: var(--space-4);
	}
	.experience__roulette {
		min-inline-size: 0;
		inline-size: 100%;
		block-size: var(--experience-viewport-height);
		overflow: hidden;
		background: transparent;
		-webkit-mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
		mask-image: linear-gradient(to bottom, transparent 0%, black 15%, black 85%, transparent 100%);
	}
	.experience__track {
		position: relative;
		display: flex;
		flex-direction: column;
		gap: var(--space-28);
		margin: 0;
		padding: 0;
		list-style: none;
		/* Posição inicial antes da primeira medição do DOM. */
		transform: translateY(calc((var(--experience-viewport-height) - var(--experience-active-height)) / 2));
		transition: transform 510ms cubic-bezier(.22, .8, .2, 1);
	}
	.experience__entry {
		--experience-item-scale: 1;
		--experience-item-opacity: 1;
		--experience-item-font-size: var(--font-size-40);
		--experience-item-line-height: 48px;
		position: relative;
		min-inline-size: 0;
	}
	.experience__entry.is-near {
		--experience-item-scale: 0.96;
		--experience-item-opacity: 0.52;
		--experience-item-font-size: var(--font-size-30);
		--experience-item-line-height: var(--line-height-38);
	}
	.experience__entry.is-far {
		--experience-item-scale: 0.91;
		--experience-item-opacity: 0.23;
		--experience-item-font-size: var(--font-size-22);
		--experience-item-line-height: var(--line-height-28);
	}
	.experience__item {
		display: flex;
		inline-size: 100%;
		align-items: center;
		gap: var(--space-16);
		min-inline-size: 0;
		transform: scale(var(--experience-item-scale));
		transform-origin: left center;
		opacity: var(--experience-item-opacity);
		transition: transform 510ms cubic-bezier(.22, .8, .2, 1), opacity 440ms var(--experience-details-ease);
	}
	.experience__expand {
		inline-size: 36px;
		block-size: 36px;
	}
	.experience__expand img { transition: transform 280ms var(--experience-details-ease); }
	.is-open .experience__expand img { transform: rotate(45deg); }
	.experience__copy {
		display: flex;
		flex: 1;
		flex-direction: column;
		gap: var(--space-8);
		min-inline-size: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: inherit;
		font-family: inherit;
		text-align: left;
	}
	.experience__item-title {
		font-size: var(--experience-item-font-size);
		font-weight: var(--font-weight-light);
		line-height: var(--experience-item-line-height);
		overflow-wrap: anywhere;
		transition: font-size 440ms var(--experience-details-ease), line-height 440ms var(--experience-details-ease);
	}
	.experience__item-meta {
		font-size: var(--font-size-13);
		font-weight: var(--font-weight-regular);
		line-height: var(--line-height-18);
		opacity: 0.48;
		overflow-wrap: anywhere;
	}
	.experience__details-reveal {
		display: grid;
		grid-template-rows: 0fr;
		inline-size: 100%;
		opacity: 0;
		visibility: hidden;
		transform: translateY(-8px) scale(.985);
		transform-origin: top left;
		transition: grid-template-rows var(--experience-details-duration) var(--experience-details-ease),
			opacity var(--experience-details-duration) var(--experience-details-ease),
			transform var(--experience-details-duration) var(--experience-details-ease),
			visibility 0s var(--experience-details-duration);
	}
	.is-open .experience__details-reveal {
		grid-template-rows: 1fr;
		opacity: 1;
		visibility: visible;
		transform: translateY(0) scale(1);
		transition-delay: 0s;
	}
	.experience__details-inner { min-block-size: 0; overflow: hidden; }
	.experience__details {
		display: flex;
		flex-direction: column;
		gap: var(--space-20);
		inline-size: 100%;
		margin-block-start: 18px;
		padding: var(--space-24);
		border: var(--border-width-1) solid rgba(242, 228, 220, .14);
		border-radius: var(--radius-28);
		background: rgba(13, 3, 5, .28);
	}
	.experience__details-description {
		margin: 0;
		font-size: var(--font-size-14);
		font-weight: var(--font-weight-regular);
		line-height: var(--line-height-22);
		opacity: .72;
	}
	.experience__skills {
		display: flex;
		flex-wrap: wrap;
		gap: var(--space-8);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.experience__skills li {
		padding: 7px 10px;
		border: var(--border-width-1) solid rgba(242, 228, 220, .16);
		border-radius: var(--radius-full);
		background: rgba(242, 228, 220, .03);
		font-size: var(--font-size-11);
		font-weight: var(--font-weight-regular);
		line-height: var(--line-height-16);
		opacity: .82;
	}
	@media (prefers-reduced-motion: reduce) {
		.experience__track,
		.experience__item,
		.experience__item-title,
		.experience__expand img,
		.experience__details-reveal { transition: none; }
	}
	@media (hover: hover) and (pointer: fine) {
		:global(html.cursor-enabled) :is(.experience__navigation-button, .experience__expand, .experience__copy),
		:global(html.cursor-enabled) :is(.experience__navigation-button, .experience__expand, .experience__copy) * {
			cursor: none;
		}
	}
	@media (min-width: 1280px) {
		/* Aproxima a entrada sem reduzir a altura do sticky ou seu percurso de scroll. */
		.experience__layout { padding-block: var(--space-64) var(--space-96); }
		.experience[data-scroll-driven] {
			min-block-size: calc(var(--experience-sticky-height, var(--experience-visual-height)) + var(--experience-scroll-distance, 0px));
		}
		.experience[data-scroll-driven] .experience__sticky {
			position: sticky;
			top: var(--nav-height);
		}
	}
	/* Contenção provisória: layout mobile final será definido em outra etapa. */
	@media (max-width: 1279px) {
		.experience__layout {
			grid-template-columns: minmax(0, 1fr);
			gap: var(--space-32);
			padding-block: var(--section-padding-y);
		}
		.experience__intro-column { max-inline-size: 430px; }
	}
</style>
