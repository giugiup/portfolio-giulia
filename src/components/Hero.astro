---
import Button from './Button.astro';
import HeroMesh from './HeroMesh.astro';
import HeroLogo from './HeroLogo.astro';
import { heroLogos } from '../data/heroLogos.js';

const { contactHref, logoSrc, arrowIconSrc } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
	<HeroMesh />
	<div class="hero__mesh-fade" aria-hidden="true"></div>
	<div class="hero__content">
		<div class="hero__logo" aria-hidden={!logoSrc ? 'true' : undefined}>
			{logoSrc && <HeroLogo />}
		</div>
		<h1 id="hero-title">
			<span>Projetos que conectam</span>
			<span>visual, interface e experiência.</span>
		</h1>
		<p class="hero__description">Lorem ipsum dolor sit amet, consectetur adipiscing elit. Fusce sit amet dui nec odio tempor tempor ut sed purus. Morbi tempus justo eu bibendum convallis.</p>
		<Button text="Entre em contato" href={contactHref} variant="hero" iconSrc={arrowIconSrc} disabled={!contactHref} />
	</div>
	<div class="hero__brands" aria-hidden={heroLogos.length === 0 ? 'true' : undefined}>
		<div class="hero__brands-viewport">
			{heroLogos.length > 0 && (
				<div class="hero__brands-track">
					{[0, 1].map((cycle) => (
						<ul class="hero__brands-list" aria-label={cycle === 0 ? 'Marcas' : undefined} aria-hidden={cycle === 1 ? 'true' : undefined}>
							{heroLogos.map(({ src, alt, width, height, cropped }) => (
								<li class:list={{ 'hero__brand-crop': cropped }} style={cropped ? `inline-size: ${width}px` : undefined}><img src={src} alt={alt} width={width} height={height} loading="lazy" /></li>
							))}
						</ul>
					))}
				</div>
			)}
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		z-index: 0;
		isolation: isolate;
		overflow: hidden;
		background-color: var(--color-bg-page);
		/* Transformação radial do node 331:1299: raios 844.17 × 506.5;
		 * centro 720,357.5 no frame 1440 × 864, preservados proporcionalmente. */
		background-image: radial-gradient(ellipse 58.6229167% 58.6226852% at 50% 41.3773148%, var(--color-wine) 0%, var(--color-hero-gradient-mid) 50%, var(--color-dark) 100%);
		color: var(--color-text-primary);
	}
	.hero__mesh {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}
	.hero__mesh-fade {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: linear-gradient(
			to bottom,
			rgba(13, 3, 5, 0) 0%,
			rgba(13, 3, 5, 0.16) 46%,
			rgba(13, 3, 5, 0.38) 66%,
			rgba(13, 3, 5, 0.8) 100%
		);
	}
	.hero__mesh-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
	.hero__content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-28);
		padding: var(--layout-hero-padding-top) var(--layout-gutter) var(--layout-hero-padding-bottom);
		text-align: center;
	}
	.hero__logo { position: relative; inline-size: 141px; block-size: 92px; flex: none; }
	.hero h1 {
		max-inline-size: 980px;
		margin: 0;
		font-family: var(--font-family-heading);
		font-size: var(--font-size-hero-display);
		font-weight: var(--font-weight-extra-bold);
		/* PROVISÓRIO mobile/tablet: proporção do line-height desktop 64/58. */
		line-height: calc(64 / 58);
		overflow-wrap: anywhere;
	}
	.hero h1 span { display: block; }
	.hero__description {
		max-inline-size: 820px;
		margin: 0;
		font-size: var(--font-size-18);
		font-weight: var(--font-weight-regular);
		/* Figma 263:792: line-height AUTO, duas linhas/46px no desktop. */
		line-height: normal;
		overflow-wrap: anywhere;
	}
	.hero__brands {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: flex-start;
		min-block-size: 200px;
		padding-block-end: var(--space-40);
		padding-inline: var(--layout-gutter);
	}
	.hero__brands-viewport {
		position: relative;
		overflow: hidden;
		inline-size: 100%;
		max-inline-size: var(--layout-content-max);
		min-block-size: 160px;
		margin-inline: auto;
		mask-image: url('/images/brands-edge-mask.svg');
		mask-size: 100% 160px;
		mask-repeat: no-repeat;
	}
	.hero__brands-track {
		position: absolute;
		inset-block-start: 50px;
		inset-inline-start: -112px;
		display: flex;
		inline-size: max-content;
		gap: 0;
		animation: logos-marquee 28s linear infinite;
		will-change: transform;
	}
	.hero__brands-list {
		display: flex;
		align-items: center;
		flex: none;
		gap: var(--space-80);
		block-size: 59px;
		margin: 0;
		padding: 0;
		padding-right: var(--space-80);
		list-style: none;
	}
	@keyframes logos-marquee {
		from { transform: translate3d(0, 0, 0); }
		to { transform: translate3d(-50%, 0, 0); }
	}
	@media (prefers-reduced-motion: reduce) {
		.hero__brands-track { animation: none; will-change: auto; }
		.hero__brands-list[aria-hidden="true"] { display: none; }
	}
	.hero__brands-list li { flex: none; }
	.hero__brands-list img { max-inline-size: none; }
	.hero__brands-list li:not(.hero__brand-crop) img { height: auto; object-fit: contain; }
	/* Transformação de image fill do node 324:220, preservando a fonte original. */
	.hero__brand-crop { position: relative; overflow: hidden; aspect-ratio: 206 / 53; }
	.hero__brand-crop img {
		position: absolute;
		inline-size: 108.47%;
		block-size: 215.42%;
		inset-inline-start: -4.24%;
		inset-block-start: -53.11%;
	}
	@media (min-width: 1280px) {
		.hero h1 { line-height: var(--line-height-64); }
	}
</style>
