---
import Button from './Button.astro';
import HeroMesh from './HeroMesh.astro';
import HeroLogo from './HeroLogo.astro';

const { contactHref, logoSrc, arrowIconSrc } = Astro.props;
---

<section class="hero" aria-labelledby="hero-title">
	<HeroMesh />
	<div class="hero__mesh-fade" aria-hidden="true"></div>
	<div class="hero__content">
		<div class="hero__logo" aria-hidden={!logoSrc ? 'true' : undefined}>
			{logoSrc && <HeroLogo />}
		</div>
		<h1 id="hero-title">
			<span>Interfaces claras, funcionais </span>
			<span>e com personalidade.</span>
		</h1>
		<p class="hero__description">Minha base em comunicação visual encontra o UX/UI para criar sites e experiências digitais com clareza, repertório visual e intenção.</p>
		<Button text="Entre em contato" href={contactHref} variant="hero" iconSrc={arrowIconSrc} disabled={!contactHref} />
	</div>
	<div class="hero__scroll-hint">
		<p>
			<span>Role para baixo</span>
			<svg width="12" height="14" viewBox="0 0 12 14" fill="none" aria-hidden="true" focusable="false">
				<path d="m2 3 4 4 4-4M2 7l4 4 4-4" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" />
			</svg>
		</p>
	</div>
</section>

<style>
	.hero {
		position: relative;
		z-index: 0;
		isolation: isolate;
		overflow: hidden;
		background-color: var(--color-bg-page);
		/* Transformação radial do node 331:1299: raios 844.17 × 506.5;
		 * centro 720,357.5 no frame 1440 × 864, preservados proporcionalmente. */
		background-image: radial-gradient(ellipse 58.6229167% 58.6226852% at 50% 41.3773148%, var(--color-wine) 0%, var(--color-hero-gradient-mid) 50%, var(--color-dark) 100%);
		color: var(--color-text-primary);
	}
	.hero__mesh {
		position: absolute;
		inset: 0;
		z-index: 0;
		pointer-events: none;
	}
	.hero__mesh-fade {
		position: absolute;
		inset: 0;
		z-index: 1;
		pointer-events: none;
		background: linear-gradient(
			to bottom,
			rgba(13, 3, 5, 0) 0%,
			rgba(13, 3, 5, 0.16) 46%,
			rgba(13, 3, 5, 0.38) 66%,
			rgba(13, 3, 5, 0.8) 100%
		);
	}
	.hero__mesh-canvas {
		display: block;
		width: 100%;
		height: 100%;
	}
	.hero__content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: var(--space-28);
		padding: var(--layout-hero-padding-top) var(--layout-gutter) var(--layout-hero-padding-bottom);
		text-align: center;
	}
	.hero__scroll-hint {
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		justify-content: center;
		min-block-size: var(--space-80);
		padding-inline: var(--layout-gutter);
	}
	.hero__scroll-hint p {
		display: inline-flex;
		align-items: center;
		gap: 8px;
		margin: 0;
		font-family: var(--font-family-base);
		font-size: var(--font-size-12);
		font-weight: var(--font-weight-regular);
		line-height: 1.5;
		letter-spacing: .1em;
		color: var(--color-sand);
		opacity: .6;
	}
	.hero__scroll-hint span { display: block; line-height: 1; }
	.hero__scroll-hint svg { display: block; flex: none; align-self: center; }
	.hero__logo { position: relative; inline-size: 141px; block-size: 92px; flex: none; }
	.hero h1 {
		max-inline-size: 980px;
		margin: 0;
		font-family: var(--font-family-heading);
		font-size: var(--font-size-hero-display);
		font-weight: var(--font-weight-extra-bold);
		/* PROVISÓRIO mobile/tablet: proporção do line-height desktop 64/58. */
		line-height: calc(64 / 58);
		overflow-wrap: anywhere;
	}
	.hero h1 span { display: block; }
	.hero__description {
		max-inline-size: 820px;
		margin: 0;
		font-size: var(--font-size-18);
		font-weight: var(--font-weight-regular);
		/* Figma 263:792: line-height AUTO, duas linhas/46px no desktop. */
		line-height: normal;
		overflow-wrap: anywhere;
	}
	@media (min-width: 1280px) {
		.hero h1 { line-height: var(--line-height-64); }
	}
	@media (max-width: 899px) {
		.hero__content {
			gap: var(--space-24);
			padding: var(--space-72) var(--layout-gutter-mobile) var(--space-80);
		}
		.hero__logo { inline-size: 116px; block-size: 76px; }
		.hero h1 {
			inline-size: 100%;
			max-inline-size: var(--hero-copy-width-mobile);
			font-size: var(--hero-title-size-mobile);
			line-height: var(--hero-title-leading-mobile);
		}
		.hero h1 span { display: inline; }
		.hero__description {
			inline-size: 100%;
			max-inline-size: var(--hero-copy-width-mobile);
			font-size: var(--font-size-16);
			line-height: 1.5;
		}
		.hero :global(.button--hero) {
			inline-size: 218px;
			min-block-size: 52px;
			padding: 14px var(--space-24);
			gap: 10px;
			font-size: var(--font-size-16);
			line-height: var(--line-height-24);
		}
		.hero__scroll-hint { display: none; }
	}
</style>
