---
interface Props {
  id: string;
  title: string;
  href?: string;
  mobileTitle?: string;
  index: number;
  image?: {
    src: string;
    alt: string;
    width: number;
    height: number;
    mobile?: { src: string; width: number; height: number };
  };
}
const { id, title, href, mobileTitle = title, index, image } = Astro.props;
// Only three decorative placeholder sets exist; reuse them for the extra slots.
const assetNumber = String(index % 3 + 1).padStart(2, '0');
---
<figure id={id} class:list={['project-cover', `project-cover--${assetNumber}`, { 'is-active': index === 0 }]} aria-label={title} data-cursor="project">
  {image ? <picture>
    {image.mobile && <source media="(max-width: 899px)" srcset={image.mobile.src} width={image.mobile.width} height={image.mobile.height} />}
    <img class="project-cover__image" src={image.src} alt={image.alt} width={image.width} height={image.height} loading="lazy" decoding="async" />
  </picture> : <>
    <div class="project-cover__diagonals" aria-hidden="true"><img src={`/images/projects/diagonals-${assetNumber}.svg`} alt="" width="800" height="650" /></div>
    <div class="project-cover__placeholder">
      <img src={`/images/projects/icon-${assetNumber}.svg`} alt="" width="40" height="40" />
      <figcaption><span>Capa do projeto</span><small>Espaço para a imagem final</small></figcaption>
    </div>
  </>}
  <span class="project-cover__mobile-action" aria-hidden="true"><img src="/icons/arrow-northeast.svg" alt="" width="18" height="18" /></span>
  <div class="project-cover__mobile-title"><h3>{mobileTitle}</h3></div>
  {href && <a class="project-cover__trigger" href={href} data-project-transition={id} data-cursor="project" aria-label={`Ver projeto: ${title}`}></a>}
</figure>
<script>
  document.querySelectorAll<HTMLAnchorElement>('a[data-project-transition]').forEach((link) => {
    link.addEventListener('click', (event) => {
      if (event.defaultPrevented || event.button !== 0 || event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || link.target === '_blank' || link.hasAttribute('download')) return;
      event.preventDefault();
      document.dispatchEvent(new CustomEvent('project-transition:start', {
        detail: { slug: link.dataset.projectTransition, url: link.href },
      }));
    });
  });
</script>
<style>
  .project-cover__mobile-action, .project-cover__mobile-title { display: none; }
  .project-cover__trigger { position: absolute; inset: 0; z-index: 1; inline-size: 100%; block-size: 100%; padding: 0; border: 0; border-radius: inherit; background: transparent; cursor: pointer; }
  .project-cover__trigger:focus-visible { outline: 2px solid var(--color-sand-light); outline-offset: -6px; }
  .project-cover { position: relative; display: grid; place-items: center; inline-size: 100%; aspect-ratio: 800 / 650; margin: 0; overflow: clip; border: 1px solid color-mix(in srgb, var(--color-sand-light) 12%, transparent); border-radius: var(--projects-radius); opacity: .4; color: var(--color-sand-light); background: radial-gradient(ellipse 760px 650px at 8% 3%, var(--color-accent), transparent), var(--color-deep-wine); }
  .project-cover.is-active { opacity: 1; }
  .project-cover { transition: opacity 450ms ease; }
  @media (prefers-reduced-motion: reduce) { .project-cover { transition: none; } }
  .project-cover--02 { color: var(--color-wine); background: radial-gradient(ellipse 760px 650px at 8% 3%, var(--color-sand-light), transparent), var(--color-sand); }
  .project-cover--03 { color: var(--color-sand); background: radial-gradient(ellipse 760px 650px at 8% 3%, var(--color-wine), transparent), #1c070a; }
  .project-cover { background-clip: padding-box; }
  .project-cover__diagonals { position: absolute; inset: -1px; }
  .project-cover__diagonals img { position: absolute; inset: 0; max-inline-size: none; }
  .project-cover__placeholder { position: relative; display: flex; flex-direction: column; align-items: center; gap: var(--space-16); max-inline-size: 100%; padding-inline: var(--space-24); text-align: center; }
  figcaption { display: flex; flex-direction: column; gap: var(--space-16); }
  figcaption span { font-size: var(--font-size-18); line-height: 26px; }
  small { font-size: var(--font-size-11); line-height: var(--line-height-18); opacity: .5; }
  .project-cover__image { position: absolute; inset: 0; inline-size: 100%; block-size: 100%; object-fit: cover; }
  @media (max-width: 899px), (max-height: 650px) { .project-cover { aspect-ratio: 4 / 3; } }
  @media (max-width: 899px) {
    .project-cover { aspect-ratio: auto; min-block-size: var(--projects-mobile-card-height); opacity: 1; }
    .project-cover__mobile-action {
      position: absolute; inset-block-start: var(--space-16); inset-inline-end: var(--space-16);
      display: grid; place-items: center; inline-size: 32px; block-size: 32px;
      border: 1px solid currentColor; border-radius: var(--radius-full); background: transparent; color: var(--color-sand-light);
      pointer-events: none;
    }
    .project-cover__mobile-action img { filter: brightness(0) invert(1); }
    .project-cover--02 .project-cover__mobile-action { color: var(--color-dark); }
    .project-cover--02 .project-cover__mobile-action img { filter: brightness(0); }
    .project-cover__mobile-title {
      position: relative; align-self: end; justify-self: stretch; display: block;
      margin: 8px; margin-block-start: 72px; padding: var(--space-16); min-block-size: 60px;
      border: 1px solid color-mix(in srgb, var(--color-sand) 20%, transparent); border-radius: var(--projects-radius);
      background: color-mix(in srgb, var(--color-dark) 85%, transparent);
      backdrop-filter: blur(8px); color: var(--color-sand-light); pointer-events: none;
    }
    .project-cover__mobile-title h3 {
      margin: 0; font-size: var(--font-size-18); font-weight: var(--font-weight-bold);
      line-height: 26px; overflow-wrap: anywhere;
    }
    .project-cover__placeholder { position: absolute; inset: 0; justify-content: center; }
  }
</style>
