---
import Button from './Button.astro';

const { logoSrc, arrowIconSrc, variant = 'default' } = Astro.props;
const isProject = variant === 'project-light';
const contactNavigation = { text: 'Contato', href: `${isProject ? '/' : ''}#contato` };
const navigation = [
	{ text: 'Projetos', href: '#projetos' },
	{ text: 'Sobre mim', href: '#sobre' },
	{ text: 'Experiência', href: '#experiencia' },
	{ text: 'Formação', href: '#formacao' },
].map(item => ({ ...item, href: `${isProject ? '/' : ''}${item.href}` }));
---

<header class:list={['site-header', { 'site-header--project-light': isProject }]}>
	<div class="site-header__inner">
		{logoSrc ? (
			<a class="site-header__logo" href="/" aria-label="Página inicial">
				<img src={logoSrc} alt="Giulia" width={isProject ? 55.1844 : 78.4651} height={isProject ? 41.4945 : 59} />
				{isProject && <img class="site-header__logo-scrolled" src="/images/giulia-logo-header.svg" alt="" aria-hidden="true" width="78.4651" height="59" />}
			</a>
		) : <div class="site-header__logo" aria-hidden="true"></div>}
		<nav class="site-header__nav" aria-label="Navegação principal">
			<ul>
				{navigation.map(({ text, href }) => <li><a href={href} data-cursor="open">{text}</a></li>)}
			</ul>
		</nav>
		<div class="site-header__actions">
			<span class="availability">
				<span class="availability__dot" aria-hidden="true"></span>
				Disponível para novos projetos
			</span>
			<Button {...contactNavigation} variant="header" iconSrc={arrowIconSrc} />
		</div>
		{!isProject && <button class="site-header__menu" type="button" aria-expanded="false" aria-controls="mobile-navigation">
			<span class="site-header__menu-surface">
				<span>Menu</span>
				<span class="site-header__menu-icon" aria-hidden="true">
					{Array.from({ length: 9 }, () => <span></span>)}
				</span>
			</span>
		</button>}
	</div>
</header>
{!isProject && <div class="mobile-menu" hidden inert>
	<nav id="mobile-navigation" aria-label="Navegação mobile">
		<ul>
			{[...navigation, contactNavigation].map(({ text, href }, index) => (
				<li style={`--menu-index: ${index}; --menu-reverse-index: ${navigation.length - index}`}><a href={href}>{text}</a></li>
			))}
		</ul>
	</nav>
</div>}

<script>
	const projectHeader = document.querySelector<HTMLElement>('.site-header--project-light');
	if (projectHeader) {
		const updateProjectHeader = () => projectHeader.classList.toggle('is-scrolled', window.scrollY > 4);
		window.addEventListener('scroll', updateProjectHeader, { passive: true });
		window.addEventListener('pageshow', updateProjectHeader);
		updateProjectHeader();
	}
	const button = document.querySelector<HTMLButtonElement>('.site-header__menu');
	const menu = document.querySelector<HTMLElement>('.mobile-menu');
	const header = document.querySelector<HTMLElement>('.site-header');
	if (button && menu && header) {
		const compact = matchMedia('(max-width: 899px)');
		const root = document.documentElement;
		const links = [...menu.querySelectorAll<HTMLAnchorElement>('a')];
		let isMenuOpen = false;
		let revision = 0;
		let restorePage: (() => void) | undefined;
		const settle = async () => {
			// Resolve the actual CSS transitions, including stagger, without timers.
			getComputedStyle(menu).opacity;
			await Promise.allSettled(menu.getAnimations({ subtree: true }).map(animation => animation.finished));
		};
		async function setMenuOpen(open: boolean, destination?: string) {
			if (open === isMenuOpen || (open && !compact.matches)) return;
			isMenuOpen = open;
			const current = ++revision;
			button!.setAttribute('aria-expanded', String(open));
			if (open) {
				if (!restorePage) {
					const x = scrollX, y = scrollY;
					const overflow = root.style.overflow;
					const main = document.querySelector('main');
					const wasInert = main?.inert ?? false;
					root.style.overflow = 'hidden';
					if (main) main.inert = true;
					restorePage = () => {
						root.style.overflow = overflow;
						if (main) main.inert = wasInert;
						window.scrollTo({ left: x, top: y, behavior: 'instant' });
					};
				}
				menu!.hidden = false;
				menu!.inert = false;
				getComputedStyle(menu!).opacity;
				menu!.classList.add('is-open');
				// Keep focus on the toggle; Tab enters the navigation.
				button!.focus({ preventScroll: true });
			} else {
				menu!.inert = true;
				menu!.classList.remove('is-open');
				if (compact.matches) button!.focus({ preventScroll: true });
				await settle();
				if (current !== revision) return;
				menu!.hidden = true;
				restorePage?.();
				restorePage = undefined;
				if (destination) {
					const target = document.querySelector<HTMLElement>(destination);
					if (target) {
						history.pushState(null, '', destination);
						target.scrollIntoView();
					}
				}
			}
		}
		button.addEventListener('click', () => void setMenuOpen(!isMenuOpen));
		menu.addEventListener('click', event => {
			const link = (event.target as Element).closest<HTMLAnchorElement>('a');
			if (link) { event.preventDefault(); void setMenuOpen(false, link.hash); }
			else void setMenuOpen(false);
		});
		document.addEventListener('keydown', event => {
			if (!isMenuOpen) return;
			if (event.key === 'Escape') { event.preventDefault(); void setMenuOpen(false); }
			if (event.key === 'Tab') {
				const focusable = [...header!.querySelectorAll<HTMLElement>('a, button'), ...links].filter(element => element.getClientRects().length);
				const index = focusable.indexOf(document.activeElement as HTMLElement);
				const next = (index + (event.shiftKey ? -1 : 1) + focusable.length) % focusable.length;
				event.preventDefault(); focusable[next].focus({ preventScroll: true });
			}
		});
		compact.addEventListener('change', () => { if (!compact.matches) void setMenuOpen(false); });
	}
</script>

<style>
	/* Page < mobile overlay (999) < existing header (1000) < PageTransition. */
	.mobile-menu { display: none; }
	@media (max-width: 899px) {
		.mobile-menu {
			position: fixed; inset: 0; z-index: 999; display: block;
			overflow-y: auto; overscroll-behavior: contain;
			padding: calc(var(--nav-height) + 56px) 24px 32px;
			background: rgba(13, 3, 5, .55);
			-webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px);
			opacity: 0; transition: opacity 250ms ease 500ms;
		}
		.mobile-menu[hidden] { display: none; }
		.mobile-menu.is-open { opacity: 1; transition-delay: 0ms; }
		.mobile-menu ul { display: flex; flex-direction: column; gap: 18px; margin: 0; padding: 0; list-style: none; }
		.mobile-menu li {
			opacity: 0; transform: translateY(12px);
			transition: opacity 350ms cubic-bezier(.22,1,.36,1), transform 350ms cubic-bezier(.22,1,.36,1);
			transition-delay: calc(var(--menu-reverse-index) * 40ms);
		}
		.mobile-menu.is-open li { opacity: 1; transform: translateY(0); transition-delay: calc(80ms + var(--menu-index) * 50ms); }
		.mobile-menu a { color: var(--color-sand-light); font-size: 30px; line-height: 1.2; font-weight: 500; text-decoration: none; }
		.mobile-menu a:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
		.site-header__menu-icon > span { transition: transform 300ms cubic-bezier(.22,1,.36,1), opacity 300ms cubic-bezier(.22,1,.36,1); }
		.site-header__menu[aria-expanded='true'] .site-header__menu-icon > span:nth-child(even) { transform: scale(0); opacity: 0; }
	}
	@media (prefers-reduced-motion: reduce) {
		.mobile-menu, .mobile-menu li, .mobile-menu.is-open li, .site-header__menu-icon > span { transition-duration: 1ms; transition-delay: 0ms; }
		.mobile-menu li { transform: none; }
	}
	.site-header__menu { display: none; }
	.site-header {
		position: sticky;
		top: 0;
		z-index: 1000;
		isolation: isolate;
		background-color: var(--color-dark);
		border-block-end: var(--border-width-1) solid var(--color-border-subtle);
	}
	.site-header__inner {
		position: relative;
		z-index: 1;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: var(--space-24);
		min-block-size: calc(var(--nav-height) - var(--border-width-1));
		padding-inline: var(--layout-gutter);
		background: transparent;
	}
	.site-header__logo {
		position: relative;
		z-index: 2;
		display: block;
		justify-self: start;
		flex: 0 0 72px;
		inline-size: 72px;
		block-size: auto;
		pointer-events: auto;
	}
	.site-header__logo img {
		display: block;
		width: 72px;
		height: auto;
		max-height: 47px;
		object-fit: contain;
	}
	/* PROVISÓRIO: navegação completa somente a partir de 1280px. */
	.site-header__nav {
		display: none;
		justify-self: center;
		position: relative;
		z-index: 2;
		pointer-events: auto;
	}
	.site-header__nav ul {
		display: flex;
		align-items: center;
		gap: var(--space-32);
		margin: 0;
		padding: 0;
		list-style: none;
	}
	.site-header__nav a {
		color: var(--color-text-primary);
		font-size: var(--font-size-16);
		font-weight: var(--font-weight-regular);
		line-height: normal;
		text-decoration: none;
		white-space: nowrap;
	}
	.site-header a:focus-visible {
		outline: var(--border-width-2) solid var(--color-text-primary);
		outline-offset: var(--space-4);
	}
	.site-header__actions {
		display: flex;
		align-items: center;
		justify-self: end;
		gap: var(--space-12);
		position: relative;
		z-index: 2;
		pointer-events: auto;
	}
	.availability {
		display: none;
		align-items: center;
		gap: var(--space-8);
		min-block-size: 26px;
		padding-inline: var(--space-12);
		border: var(--border-width-1) solid var(--color-border-subtle);
		border-radius: var(--radius-full);
		background-color: var(--color-bg-page);
		color: var(--color-text-primary);
		font-size: var(--font-size-11);
		font-weight: var(--font-weight-regular);
		line-height: var(--line-height-16);
		white-space: nowrap;
	}
	.availability__dot {
		inline-size: 5px;
		block-size: 5px;
		border-radius: var(--radius-full);
		background-color: var(--color-status-available);
		animation: availability-pulse 1.8s ease-in-out infinite;
		transform-origin: center;
	}

	@keyframes availability-pulse {
		0%,
		100% {
			opacity: 0.55;
			transform: scale(0.9);
			box-shadow: 0 0 0 0 rgba(180, 221, 50, 0);
		}

		50% {
			opacity: 1;
			transform: scale(1);
			box-shadow: 0 0 0 4px rgba(180, 221, 50, 0.12);
		}
	}
	/* PROVISÓRIO: badge oculto no mobile para preservar logo e CTA. */
	@media (min-width: 768px) { .availability { display: inline-flex; } }
	@media (min-width: 1280px) {
		.site-header__inner { padding-inline: var(--space-40); }
		.site-header__logo { inline-size: 60px; }
		.site-header__logo img { width: 60px; max-height: 39px; }
		.site-header__nav { display: block; }
	}
	@media (max-width: 899px) {
		.site-header__inner {
			display: flex;
			justify-content: space-between;
			padding-inline: var(--layout-gutter-mobile);
			gap: var(--layout-grid-gap-mobile);
		}
		.site-header__logo { flex-basis: 47.3px; inline-size: 47.3px; block-size: 30.8px; }
		.site-header__logo img {
			inline-size: auto;
			block-size: 30.8px;
			max-block-size: none;
			margin-inline: auto;
		}
		.site-header__nav, .site-header__actions { display: none; }
		.site-header__menu {
			display: inline-flex;
			align-items: center;
			flex-shrink: 0;
			inline-size: 99px;
			block-size: 44px;
			padding: 0;
			border: 0;
			background: transparent;
			color: var(--color-button-light-text);
			font-family: var(--font-family-base);
			font-size: var(--font-size-16);
			font-weight: var(--font-weight-bold);
			line-height: var(--line-height-24);
			cursor: pointer;
		}
		.site-header__menu-surface {
			display: flex;
			align-items: center;
			justify-content: center;
			gap: var(--space-8);
			inline-size: 100%;
			block-size: 36px;
			border-radius: var(--radius-full);
			background: var(--color-button-light-bg);
		}
		.site-header__menu-icon {
			display: grid;
			grid-template-columns: repeat(3, 2.5px);
			gap: 3px;
			justify-content: center;
			align-content: center;
			flex: 0 0 14px;
			inline-size: 14px;
			block-size: 14px;
		}
		.site-header__menu-icon > span {
			inline-size: 2.5px;
			block-size: 2.5px;
			border-radius: var(--radius-full);
			background: currentColor;
		}
		.site-header__menu:active { opacity: 0.8; }
		.site-header__menu:focus-visible {
			outline: var(--border-width-2) solid var(--color-text-primary);
			outline-offset: var(--space-4);
			border-radius: var(--radius-full);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.availability__dot {
			animation: none;
			opacity: 1;
			transform: none;
			box-shadow: none;
		}
	}
</style>
