---
import { heroLogos } from '../data/heroLogos.js';
---

	<div class="logo-carousel" aria-hidden={heroLogos.length === 0 ? 'true' : undefined}>
		<div class="logo-carousel-viewport">
			{heroLogos.length > 0 && (
				<div class="logo-carousel-track">
					{[0, 1].map((cycle) => (
						<ul role="list" class="logo-carousel-list" aria-label={cycle === 0 ? 'Marcas' : undefined} aria-hidden={cycle === 1 ? 'true' : undefined}>
							{heroLogos.map(({ src, alt, width, height, cropped }) => (
								<li class:list={{ 'logo-carousel-crop': cropped }} style={`--logo-width: ${width * Math.min(.58, 36 / height)}px; --logo-height: ${height * Math.min(.58, 36 / height)}px`}><img src={src} alt={alt} width={width} height={height} loading="lazy" /></li>
							))}
						</ul>
					))}
				</div>
			)}
		</div>
	</div>

<style>
	.logo-carousel {
		--logo-carousel-gap: var(--space-32);
		position: relative;
		z-index: 2;
		display: flex;
		align-items: center;
		inline-size: 100%;
		min-inline-size: 0;
		block-size: var(--space-80);
	}
	.logo-carousel-viewport {
		position: relative;
		overflow: hidden;
		inline-size: 100%;
		max-inline-size: var(--layout-content-max);
		block-size: var(--space-80);
		margin-inline: auto;
		mask-image: linear-gradient(to right, transparent 0%, black 8%, black 92%, transparent 100%);
		mask-size: 100% 100%;
		mask-repeat: no-repeat;
	}
	.logo-carousel-track {
		display: flex;
		inline-size: max-content;
		gap: 0;
		animation: logos-marquee 28s linear infinite;
		will-change: transform;
	}
	.logo-carousel-list {
		display: flex;
		align-items: center;
		flex: none;
		gap: var(--logo-carousel-gap);
		block-size: var(--space-80);
		margin: 0;
		padding: 0;
		padding-right: var(--logo-carousel-gap);
		list-style: none;
	}
	/* Cada ciclo inclui o gap final; -50% acompanha sua nova largura. */
	@keyframes logos-marquee {
		from { transform: translate3d(0, 0, 0); }
		to { transform: translate3d(-50%, 0, 0); }
	}
	@media (prefers-reduced-motion: reduce) {
		.logo-carousel-track { animation: none; will-change: auto; }
		.logo-carousel-list[aria-hidden="true"] { display: none; }
	}
	.logo-carousel-list li { flex: none; inline-size: var(--logo-width); block-size: var(--logo-height); opacity: .7; }
	.logo-carousel-list img { display: block; inline-size: 100%; block-size: 100%; max-inline-size: none; }
	.logo-carousel-list li:not(.logo-carousel-crop) img { object-fit: contain; }
	/* Transformação de image fill do node 324:220, preservando a fonte original. */
	.logo-carousel-crop { position: relative; overflow: hidden; aspect-ratio: 206 / 53; }
	.logo-carousel-crop img {
		position: absolute;
		inline-size: 108.47%;
		block-size: 215.42%;
		inset-inline-start: -4.24%;
		inset-block-start: -53.11%;
	}

	@media (min-width: 768px) { .logo-carousel { --logo-carousel-gap: var(--space-56); } }
</style>
